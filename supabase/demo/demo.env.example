# Demo operator environment — copy to a file OUTSIDE the repository (or to
# supabase/demo/<name>.env, which is git-ignored) and point DEMO_ENV_FILE at it.
# Never commit real values. Never put Production values here — the tools refuse them.

# The Demo project's ref (20 lowercase letters), or `local` for a loopback-only rehearsal stack.
DEMO_PROJECT_REF=
# Postgres connection string of the Demo project (db.<ref>.supabase.co or the <ref> pooler user).
DEMO_DB_URL=
# https://<ref>.supabase.co
DEMO_SUPABASE_URL=
# Demo project service-role (secret) key — Storage upload/purge and seed_first_admin.mjs only.
DEMO_SERVICE_ROLE_KEY=
# Demo project anon / publishable key — portal smoke test only (what the portal page itself holds).
DEMO_ANON_KEY=
# Optional: defaults to <DEMO_SUPABASE_URL>/functions/v1
DEMO_FUNCTIONS_URL=
# The authenticated Demo operator (created by tools/demo-operator.sh via seed_first_admin.mjs).
DEMO_OPERATOR_EMAIL=demo.operator@example.invalid
# Only needed when creating/refreshing the operator. ≥ 8 characters. Never committed, never printed.
DEMO_OPERATOR_PASSWORD=
# Destructive steps only: RESET-DEMO-<DEMO_PROJECT_REF>. Set it per command, not in this file.
# DEMO_RESET_CONFIRM=
