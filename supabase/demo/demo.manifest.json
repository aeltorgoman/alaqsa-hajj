  },

  "demo_anchor_date": "2026-10-01",
  "anchor_policy": {
    "rule": "Every seeded business date is DEMO_ANCHOR_DATE plus or minus a fixed day offset.",
    "forbidden_in_seeded_business_data": ["CURRENT_DATE", "now()", "clock_timestamp()", "random()", "gen_random_uuid() as a business value"],
    "out_of_scope_for_determinism": [
      "created_at / updated_at defaults",
      "payment_receipts.issued_at and cancelled_at (set to wall-clock by the receipt RPCs)",
      "audit_log rows",
      "storage object metadata timestamps"
    ],
    "drift_window_days": 45,
    "drift_note": "Expiry alerts, announcement visibility and the travel phase are evaluated by the application against the real current date. The anchor-relative offsets below keep every expected alert count stable while the real date is within drift_window_days after the anchor. Moving the anchor is a deliberate, reviewed change to this file."
  },

  "safety": {
    "production_targets_allowed": false,
    "requires_dedicated_demo_project": true,
    "requires_in_database_demo_sentinel": true,
    "uses_app_season_maintenance_while_seeding": false,
    "app_season_maintenance_in_reset": "only if delete_season() is proven insufficient; transaction-local; after all demo target guards pass; documented; never in Production",
    "weakens_rls_triggers_constraints_or_grants": false,
    "secrets_in_repository": false,
    "real_or_production_derived_records": 0
  },

