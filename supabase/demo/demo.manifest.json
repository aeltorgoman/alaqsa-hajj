  "status": "contract-only — no seed, generator, guard or verifier implemented yet",
  "description": "Expected end state of the persistent Sales Demo environment. This file is the independent contract that the future seed must produce and the future verifier must assert. It describes state, not implementation.",
  "repository_baseline": {
    "main_sha": "be236a88ee26d48d15d8fc07b96021daa7f34dac",
